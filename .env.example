# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Convex: written by `npx convex dev`
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Azure Blob Storage. The backend reads these from the Convex deployment
# (npx convex env set); npm run test:live reads them from this file.
# Never prefix them with VITE_, which ships them to the browser.
AZURE_BLOB_ACCOUNT=
AZURE_BLOB_CONTAINER=
# Optional, defaults to https://<account>.blob.core.windows.net
AZURE_BLOB_ENDPOINT=

# Either an account key...
AZURE_BLOB_KEY=

# ...or Microsoft Entra. The app registration needs Storage Blob Data
# Contributor and Storage Blob Delegator on the account.
AZURE_BLOB_TENANT_ID=
AZURE_BLOB_CLIENT_ID=
AZURE_BLOB_CLIENT_SECRET=

# Live tests only (optional)
# Adds the CORS preflight check, e.g. http://localhost:5173
AZURE_LIVE_ORIGIN=
# https URL of a small PNG; adds the storeFromUrl test
AZURE_LIVE_COPY_SOURCE=
