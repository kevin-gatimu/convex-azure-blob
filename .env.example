# Copy to .env.local (gitignored) and fill in. Never commit real values.
# The README's "Environment variables" section explains each one.
# The Convex backend reads AZURE_BLOB_* from the deployment (npx convex env set);
# npm run test:live reads this file. Never prefix them with VITE_, which ships
# them to the browser.

# ---------------------------------------------------------------------------
# Convex (written by `npx convex dev`)
# ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# ---------------------------------------------------------------------------
# App account, Microsoft Entra: used by the backend and the Entra live tests.
# Works with shared key access disabled. The app registration needs Storage
# Blob Data Contributor and Storage Blob Delegator on this account.
# ---------------------------------------------------------------------------
AZURE_BLOB_ACCOUNT=
AZURE_BLOB_CONTAINER=
# https://<account>.blob.core.windows.net, as the browser sees it
AZURE_BLOB_ENDPOINT=
AZURE_BLOB_TENANT_ID=
AZURE_BLOB_CLIENT_ID=
AZURE_BLOB_CLIENT_SECRET=
# To sign this account with a shared key instead, set its key here. When set,
# it wins and the three Entra values above are ignored.
AZURE_BLOB_KEY=

# ---------------------------------------------------------------------------
# Shared key account: live tests only, the app never reads these.
# A separate account that allows shared key access. Leave empty to skip the
# shared key tests (or to run them on the app account via AZURE_BLOB_KEY).
# ---------------------------------------------------------------------------
AZURE_BLOB_SHARED_KEY_ACCOUNT=
AZURE_BLOB_SHARED_KEY_CONTAINER=
# Optional, defaults to https://<shared key account>.blob.core.windows.net
AZURE_BLOB_SHARED_KEY_ENDPOINT=
AZURE_BLOB_SHARED_KEY=

# ---------------------------------------------------------------------------
# Live test options (optional)
# ---------------------------------------------------------------------------
# Adds the CORS preflight check, e.g. http://localhost:5173
AZURE_BLOB_CORS_ORIGIN=
# https URL of a small PNG; adds the storeFromUrl test
AZURE_BLOB_COPY_SOURCE=
