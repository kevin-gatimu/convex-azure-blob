{
  "name": "convex-azure-blob",
  "description": "Azure Blob Storage for Convex: direct browser uploads with short-lived SAS URLs, file metadata in Convex, and no Azure SDK.",
  "repository": "github:kevin-gatimu/convex-azure-blob",
  "homepage": "https://github.com/kevin-gatimu/convex-azure-blob#readme",
  "bugs": {
    "url": "https://github.com/kevin-gatimu/convex-azure-blob/issues"
  },
  "author": "Kevin Gatimu",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "keywords": [
    "convex",
    "component",
    "azure",
    "azure-blob-storage",
    "blob",
    "storage",
    "file-upload",
    "sas"
  ],
  "type": "module",
  "scripts": {
    "dev": "convex dev --typecheck-components --start 'npm run dev:build'",
    "dev:frontend": "cd example && vite",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.ts' 'src/**/*.tsx' -i '**/*.test.ts' -c 'npm run build:codegen' --initial",
    "predev": "convex init && npm run build:codegen",
    "azurite:setup": "node scripts/azurite-setup.mjs",
    "build": "tsc --project ./tsconfig.build.json",
    "build:codegen": "npx convex codegen --component-dir ./src/component && npm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && npm run build:codegen",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit && tsc -p example && tsc -p example/convex",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "prepare": "npm run build",
    "preversion": "npm ci && npm run build:clean && npm run test && npm run lint && npm run typecheck",
    "alpha": "npm version prerelease --preid alpha && npm publish --tag alpha && git push --follow-tags",
    "release": "npm version patch && npm publish && git push --follow-tags"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "peerDependencies": {
    "convex": "^1.43.0",
    "react": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "convex-helpers": "^0.1.128"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "9.39.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "chokidar-cli": "3.0.0",
    "convex": "^1.47.0",
    "convex-test": "^0.0.62",
    "eslint": "9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "pkg-pr-new": "^0.0.86",
    "prettier": "3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.11"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js"
}
